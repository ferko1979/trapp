<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <fragment
        android:id="@+id/map"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- TOP HUD — level/points pill, inbox bell, nearby + GPS chips (Compose) -->
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/composeTopHud"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:elevation="20dp" />

    <!-- NEARBY PROXIMITY RADAR OVERLAY -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/radarCard"
        android:layout_width="76dp"
        android:layout_height="76dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="62dp"
        android:layout_marginEnd="12dp"
        app:cardBackgroundColor="@color/scrim_dark"
        app:cardCornerRadius="38dp"
        app:cardElevation="15dp"
        app:strokeColor="@color/border_default"
        app:strokeWidth="1dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <com.fairco.trap.views.RadarView
                android:id="@+id/proximitySensorRadar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="4dp" />

            <ImageButton
                android:id="@+id/btnToggleRadar"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_rounded_dark"
                android:backgroundTint="#80FFFFFF"
                android:src="@android:drawable/ic_media_play"
                android:tint="@color/accent_red"
                android:padding="4dp"
                android:contentDescription="@string/action_toggle_tracking" />
        </FrameLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- BANNER AD — sits just above the bag card; bottomMargin updated dynamically in GameActivity -->
    <FrameLayout
        android:id="@+id/bannerAdContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="130dp"
        android:elevation="2dp"
        android:background="@color/bg_surface"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:visibility="gone">

        <View
            android:id="@+id/bannerAdTopBorder"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_gravity="top"
            android:background="@color/border_default" />

        <!-- AdView is created in code: unit ID comes from admin settings (test unit in debug) -->
        <FrameLayout
            android:id="@+id/bannerAdView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />

    </FrameLayout>

    <!-- BOTTOM DOCK — trap selector + PLACE + tab bar (Compose); pads itself above the nav bar -->
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/composeBottomDock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:elevation="16dp" />

    <!-- RIGHT-SIDE CONTROLS — zoom, location, disarm; repositioned above banner ad dynamically -->
    <LinearLayout
        android:id="@+id/rightSideControls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="168dp"
        android:gravity="center_horizontal">

        <!-- Disarm nearby (shown only when a nearby trap is detected) -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnDisarmNearby"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:visibility="gone"
            app:srcCompat="@drawable/ic_disassemble"
            app:fabSize="normal"
            app:backgroundTint="#BFFFB648"
            app:tint="@color/white"
            android:contentDescription="Disassemble Nearby Trap"
            app:borderWidth="0dp"
            app:elevation="8dp" />

        <!-- Center-on-me -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/myLocationButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:srcCompat="@android:drawable/ic_menu_mylocation"
            app:fabSize="mini"
            app:backgroundTint="#E6070E1A"
            app:tint="#FF38D3F2"
            android:contentDescription="@string/action_my_location"
            app:borderWidth="0dp"
            app:elevation="4dp" />

        <!-- Layers: heatmap, reload, theme -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnLayers"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:srcCompat="@drawable/ic_layers"
            app:fabSize="mini"
            app:backgroundTint="#E6070E1A"
            app:tint="#FF38D3F2"
            android:contentDescription="Map layers"
            app:borderWidth="0dp"
            app:elevation="4dp" />


    </LinearLayout>

    <!-- TRAP COMPASS — corner widget pointing toward the nearest detected trap -->
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/composeTrapCompass"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="12dp"
        android:layout_marginBottom="120dp"
        android:elevation="190dp"
        android:visibility="gone" />

    <!-- TRAP INFO / DISASSEMBLE OVERLAY — Compose full-screen (shown when tapping a trap marker) -->
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/composeTrapInfoOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="200dp"
        android:visibility="gone" />

    <!-- PLACEMENT HOLD OVERLAY — Compose full-screen (shown when trap is selected for placement) -->
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/composePlacementOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="250dp"
        android:visibility="gone" />

    <!-- TRAPPED OVERLAY — full-screen, shown when the player walks into an enemy trap -->
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/composeTrappedOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="350dp"
        android:visibility="gone" />

    <!-- REWARD POPUP OVERLAY — shown after login reward or hourly Day-1 bonus -->
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/composeRewardOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="400dp"
        android:visibility="gone" />

    <!-- CAPTURE VICTORY OVERLAY — shown to the trap owner when their trap fires -->
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/composeCaptureVictoryOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="450dp"
        android:visibility="gone" />

    <!-- LOADING OVERLAY — covers map while data loads on first boot -->
    <FrameLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#EE070E1A"
        android:elevation="300dp"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp">

            <ProgressBar
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:indeterminateTint="@color/accent_cyan" />

            <TextView
                android:id="@+id/tvLoadingStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/label_loading"
                android:textColor="@color/text_muted"
                android:textSize="13sp"
                android:letterSpacing="0.05" />
        </LinearLayout>
    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
