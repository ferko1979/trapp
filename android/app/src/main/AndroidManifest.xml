<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />

    <queries>
        <package android:name="com.google.android.gms" />
        <package android:name="com.android.vending" />
        <package android:name="com.google.android.gsf" />
        <package android:name="com.google.android.providers.gsf" />
        <package android:name="com.google.android.gms.policy_sidecar_aps" />
        <!-- Invite apps -->
        <package android:name="com.whatsapp" />
        <package android:name="com.viber.voip" />
        <intent>
            <action android:name="com.google.android.gms.api.service.START" />
        </intent>
        <intent>
            <action android:name="com.google.android.gms.auth.api.signin.Service.START" />
        </intent>
        <intent>
            <action android:name="com.google.android.gms.common.service.START" />
        </intent>
        <!-- Revolut checkout + any HTTPS link opened in browser / Custom Tabs -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <!-- SMS invite: opens system SMS app -->
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
    </queries>

    <application
        android:name=".TrapApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Trapp"
        android:hardwareAccelerated="true">

        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <!--
            AdMob App ID — replace with your real ID from AdMob console once approved.
            For local testing, this uses Google's official test App ID which never charges real money.
            Production ID format: ca-app-pub-XXXXXXXXXXXXXXXX~XXXXXXXXXX
        -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${ADMOB_APP_ID}" />

        <activity android:name=".AwardsActivity"                 android:exported="false" />
        <activity android:name=".ProfileEditActivity"          android:exported="false" />
        <activity android:name=".FriendsActivity"              android:exported="false" />
        <activity android:name=".InviteFriendsActivity"        android:exported="false" />
        <activity android:name=".CreateSupportTicketActivity"  android:exported="false" />
        <activity android:name=".SupportTicketsActivity"       android:exported="false" />
        <activity android:name=".SupportThreadActivity"        android:exported="false" />
        <activity android:name=".MaintenanceActivity"          android:exported="false" />
        <activity
            android:name=".RegisterActivity"
            android:launchMode="singleTop"
            android:exported="true">
            <!-- Deep link: https://playtrapnow.web.app/invite?ref=XXXX -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="playtrapnow.web.app"
                    android:path="/invite" />
            </intent-filter>
        </activity>
        <activity android:name=".LoginActivity"           android:exported="false" />
        <activity android:name=".LandingActivity"         android:exported="false" />
        <activity android:name=".GameActivity"            android:exported="false" />
        <activity android:name=".RankingActivity"         android:exported="false" />
        <activity android:name=".SubscriptionActivity"    android:exported="false" />
        <activity android:name=".DonationActivity"        android:exported="false" />
        <activity android:name=".CaptureHistoryActivity"  android:exported="false" />
        <activity android:name=".InboxActivity"           android:exported="false" />
        <activity android:name=".ConversationsActivity"   android:exported="false" />
        <activity android:name=".ChatActivity"            android:exported="false" />
        <activity
            android:name=".IntroActivity"
            android:exported="false"
            android:theme="@style/Theme.Trapp" />

        <activity android:name="com.fairco.trap.ui.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".LocationTrackingService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- FCM token refresh + push message handler -->
        <service
            android:name=".TrapMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>
</manifest>
