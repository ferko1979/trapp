<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_deep">

    <!-- Header -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="Invite Friends"
        app:navigationIcon="@drawable/ic_back"
        app:titleTextColor="@color/white"
        android:background="@color/accent_cyan" />

    <!-- Invite banner / illustration -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#0F172A"
        android:paddingVertical="20dp"
        android:paddingHorizontal="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🪤"
            android:textSize="40sp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Set traps. Catch friends."
            android:textColor="#F1F5F9"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Invite your contacts to join TRAPP"
            android:textColor="#64748B"
            android:textSize="13sp"
            android:layout_marginTop="4dp"/>
    </LinearLayout>

    <!-- Search bar -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/searchLayout"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="4dp"
        app:startIconDrawable="@drawable/ic_search"
        app:hintTextColor="#64748B"
        android:hint="Search contacts…">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPersonName"
            android:imeOptions="actionSearch"/>
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Select all / count row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp">

        <TextView
            android:id="@+id/tvSelectedCount"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:textColor="#64748B"
            android:textSize="12sp"
            tools:text="0 selected"/>

        <Button
            android:id="@+id/btnSelectAll"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select All"
            android:textColor="#3B82F6"
            android:textSize="12sp"/>

        <Button
            android:id="@+id/btnClearAll"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Clear"
            android:textColor="#64748B"
            android:textSize="12sp"/>
    </LinearLayout>

    <!-- Contacts list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvContacts"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="88dp"/>

    <!-- Bottom send bar (elevated above list) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/sendBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardElevation="12dp"
        app:cardBackgroundColor="#1E293B"
        app:cardCornerRadius="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Preview of the invite message -->
            <TextView
                android:id="@+id/tvMessagePreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:maxLines="2"
                android:ellipsize="end"
                android:layout_marginBottom="12dp"
                tools:text="Hey! I'm playing TRAPP — come join me! https://play.google.com/..."/>

            <!-- Row 1: SMS + Generic Share -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <Button
                    android:id="@+id/btnSendSms"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="44dp"
                    android:text="📱 SMS"
                    android:backgroundTint="#1E3A8A"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:enabled="false"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btnShare"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="44dp"
                    android:text="↗ Share"
                    android:backgroundTint="#065F46"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:enabled="false"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <!-- Row 2: WhatsApp + Viber + Email -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <Button
                    android:id="@+id/btnShareWhatsapp"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="44dp"
                    android:text="💬 WhatsApp"
                    android:backgroundTint="#128C7E"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:enabled="false"
                    android:layout_marginEnd="3dp" />

                <Button
                    android:id="@+id/btnShareViber"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="44dp"
                    android:text="📞 Viber"
                    android:backgroundTint="#7360F2"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:enabled="false"
                    android:layout_marginHorizontal="3dp" />

                <Button
                    android:id="@+id/btnShareEmail"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="44dp"
                    android:text="✉ Email"
                    android:backgroundTint="#475569"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:enabled="false"
                    android:layout_marginStart="3dp" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
