<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="40dp"
    android:background="@color/radar_bg">

    <!-- Icon / Emoji display -->
    <TextView
        android:id="@+id/tvSlideIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="72sp"
        android:gravity="center"
        android:layout_marginBottom="32dp" />

    <!-- Slide title -->
    <TextView
        android:id="@+id/tvSlideTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:gravity="center"
        android:fontFamily="@font/exo2"
        android:lineSpacingMultiplier="1.15"
        android:layout_marginBottom="20dp" />

    <!-- Slide description -->
    <TextView
        android:id="@+id/tvSlideDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="15sp"
        android:textColor="@color/text_secondary"
        android:gravity="center"
        android:lineSpacingMultiplier="1.5"
        android:layout_marginBottom="12dp" />

    <!-- Optional highlight tip box -->
    <LinearLayout
        android:id="@+id/tipBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_intro_tip"
        android:padding="14dp"
        android:gravity="center_vertical"
        android:layout_marginTop="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvTipIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:layout_marginEnd="10dp" />

        <TextView
            android:id="@+id/tvTipText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="13sp"
            android:textColor="@color/accent_cyan"
            android:lineSpacingMultiplier="1.35" />

    </LinearLayout>

</LinearLayout>
