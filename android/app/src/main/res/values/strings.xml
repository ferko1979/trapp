    <!-- Slide 1 — Welcome -->
    <string name="intro_s1_icon">🪤</string>
    <string name="intro_s1_title">Welcome to Trapp!</string>
    <string name="intro_s1_desc">The real-world trap game where you place hidden traps on a live map and catch other players — right in your neighbourhood.</string>
    <string name="intro_s1_tip_icon">📍</string>
    <string name="intro_s1_tip">Trapp uses your real GPS location — go outside for the full experience!</string>

    <!-- Slide 2 — Trap Bag -->
    <string name="intro_s2_icon">🎒</string>
    <string name="intro_s2_title">Your Trap Bag</string>
    <string name="intro_s2_desc">You start with a set of traps in your bag. Each trap type has different effects, placement times, and recharge cycles.\n\nOpen the Trap Bag at the bottom of the map to see what you\'re carrying.</string>
    <string name="intro_s2_tip_icon">⏱</string>
    <string name="intro_s2_tip">Traps recharge automatically over time — check back if your bag is low.</string>

    <!-- Slide 3 — Place a Trap -->
    <string name="intro_s3_icon">📍</string>
    <string name="intro_s3_title">Place a Trap</string>
    <string name="intro_s3_desc">1. Tap a spot on the map near you.\n2. Pick a trap from your bag.\n3. Walk to the chosen location.\n4. Hold the PUSH button until placement completes.\n\nYour trap is now live and invisible to others!</string>
    <string name="intro_s3_tip_icon">📏</string>
    <string name="intro_s3_tip">You must be within 20 m of the placement point. Pick a clever hiding spot!</string>

    <!-- Slide 4 — Catch Players -->
    <string name="intro_s4_icon">💥</string>
    <string name="intro_s4_title">Catch Players</string>
    <string name="intro_s4_desc">When another player walks into the radius of your active trap, they get caught automatically.\n\nYou earn XP, their daily trap quota is reduced, and you climb the leaderboard.</string>
    <string name="intro_s4_tip_icon">👀</string>
    <string name="intro_s4_tip">You can see your own active traps on the map — others can\'t!</string>

    <!-- Slide 5 — Avoid & Disarm -->
    <string name="intro_s5_icon">🛡️</string>
    <string name="intro_s5_title">Avoid &amp; Disarm</string>
    <string name="intro_s5_desc">Other players are setting traps for you too!\n\nIf you spot a trap marker on the map, walk close and hold the DISARM button to neutralise it before it catches you.</string>
    <string name="intro_s5_tip_icon">⚠️</string>
    <string name="intro_s5_tip">Being caught reduces your daily traps available. Stay alert!</string>

    <!-- Slide 6 — Friends & Allies -->
    <string name="intro_s6_icon">🤝</string>
    <string name="intro_s6_title">Friends &amp; Allies</string>
    <string name="intro_s6_desc">Add friends, form Ally Groups, and coordinate your trapping strategy.\n\nCheck the leaderboard to see who\'s on top — then go out and beat them.</string>
    <string name="intro_s6_tip_icon">🏆</string>
    <string name="intro_s6_tip">Each day is a fresh start. Traps reset, scores accumulate. Good luck!</string>

