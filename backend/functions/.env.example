# Copy this file to .env and fill in real values.
# .env is gitignored — never commit it. On CI/CD inject these as secrets instead.

# Transactional email over SMTP (verification, support replies, automations).
# Recommended: Resend SMTP — no code change needed, better deliverability once
# the sending domain is verified (SPF + DKIM + DMARC) in the Resend dashboard.
#   SMTP_HOST=smtp.resend.com  SMTP_PORT=465  SMTP_SECURE=true
#   SMTP_USER=resend           SMTP_PASS=<Resend API key, re_...>
# Port 465 requires SMTP_SECURE=true; port 587 uses STARTTLS with SMTP_SECURE=false.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=your_resend_api_key_here
SMTP_FROM_EMAIL=noreply@your-verified-domain.example
SMTP_FROM_NAME=PlayTrap
