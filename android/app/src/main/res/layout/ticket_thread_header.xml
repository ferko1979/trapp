<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.tools"
    android:id="@+id/ticketHeader"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/bg_deep"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp">

    <TextView
        android:id="@+id/tvTicketNo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:textColor="@color/text_muted"
        android:fontFamily="monospace"
        tools:text="TCK-20260512-0003"/>

    <TextView
        android:id="@+id/tvTicketSubject"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="15sp"
        android:textColor="@color/text_primary"
        android:textStyle="bold"
        android:layout_marginTop="2dp"
        tools:text="Change my email address"/>

    <com.google.android.material.chip.Chip
        android:id="@+id/chipStatus"
        style="@style/Widget.MaterialComponents.Chip.Choice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textSize="11sp"
        app:chipMinHeight="24dp"
        android:clickable="false"
        tools:text="answered"
        tools:chipBackgroundColor="@color/accent_green"
        tools:textColor="@color/white"/>

    <TextView
        android:id="@+id/bannerReplyPrompt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@color/bg_surface"
        android:padding="8dp"
        android:textColor="@color/accent_gold"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:visibility="visible"
        tools:text="Support is waiting for your reply." />
</LinearLayout>
