<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_trap_alert_sheet"
    android:paddingHorizontal="20dp"
    android:paddingTop="16dp"
    android:paddingBottom="8dp">

    <!-- ── Alarm header ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <ImageView
            android:id="@+id/ivTrapIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_trap_warning"
            android:contentDescription="Trap icon" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/tvAlertTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚠️ TRAP DETECTED"
                android:textColor="#FCD34D"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTrapDistance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#94A3B8"
                android:textSize="13sp"
                tools:text="142m away · danger zone: 25m radius" />
        </LinearLayout>
    </LinearLayout>

    <!-- Distance / progress bar -->
    <ProgressBar
        android:id="@+id/pbProximity"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:progressTint="#F59E0B"
        android:progressBackgroundTint="#1E293B"
        android:max="200"
        android:progress="50"
        android:layout_marginBottom="12dp" />

    <!-- Phase instructions -->
    <TextView
        android:id="@+id/tvInstructions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#CBD5E1"
        android:textSize="13sp"
        android:textAlignment="center"
        android:layout_marginBottom="10dp"
        tools:text="Walk closer to reveal the trap type" />

    <!-- Disassembly countdown — visible only while Disarming -->
    <TextView
        android:id="@+id/tvDisarmCountdown"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#34D399"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textAlignment="center"
        android:layout_marginBottom="10dp"
        android:visibility="gone"
        tools:text="⏱ 12s remaining" />

    <!-- Two-option cards — visible only in NearbyDetected -->
    <LinearLayout
        android:id="@+id/layoutOptions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp"
        android:visibility="gone">

        <!-- Option A: Disassemble -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/bg_option_card"
            android:padding="10dp"
            android:layout_marginEnd="5dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🛠  Disassemble"
                android:textColor="#60A5FA"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvDisassembleOption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:lineSpacingMultiplier="1.3"
                tools:text="Get within 30m → hold to reveal → hold to disassemble. Time shown after reveal." />
        </LinearLayout>

        <!-- Option B: Avoid -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/bg_option_card"
            android:padding="10dp"
            android:layout_marginStart="5dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🚶  Avoid"
                android:textColor="#34D399"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvAvoidOption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:lineSpacingMultiplier="1.3"
                tools:text="Stay beyond the danger zone and navigate around it. Dismiss to continue walking." />
        </LinearLayout>
    </LinearLayout>

    <!-- Action button (label changes per phase) -->
    <Button
        android:id="@+id/btnAction"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Approach to Reveal"
        android:backgroundTint="#1E3A8A"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnIgnore"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:text="Dismiss — I'll avoid it"
        android:textColor="#64748B" />

</LinearLayout>
