<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!--
            Cloud backup disabled: auth tokens, Firebase cache, AdMob state, and
            real-time game data are device-specific and must not be restored to
            a different install. These paths are excluded explicitly.
        -->
        <exclude domain="sharedpref" path="firebase-installations-store.json" />
        <exclude domain="sharedpref" path="com.google.android.gms.appid.xml" />
        <exclude domain="sharedpref" path="google_app_measurement.db" />
        <exclude domain="database" path="google_app_measurement_local.db" />
        <exclude domain="database" path="com.google.android.datatransport.events" />
        <exclude domain="database" path="frc_loaded_tables.json" />
    </cloud-backup>
    <device-transfer>
        <!--
            Device-to-device: only transfer UI preferences (theme, sound, language).
            All other domains are excluded by default when only <include> is specified.
        -->
        <include domain="sharedpref" path="Settings.xml" />
    </device-transfer>
</data-extraction-rules>
